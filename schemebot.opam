opam-version: "2.0"
synopsis: "Bot for executing code as a Zulip bot."
description:
  "Executes code through chez scheme whenever invoked and responds with the result. Meant to be deployed on Google Cloud Run."
authors: ["Emin Arslan <me@emin.engineer>"]
license: "LICENSE"
tags: ["http" "scheme" "bot"]
homepage: "https://github.com/haxala1r/schemebot"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/haxala1r/schemebot/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/haxala1r/schemebot.git"
